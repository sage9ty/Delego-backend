{
  "name": "@delegolabs/utils",
  "version": "0.0.1",
  "description": "Shared utility functions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/DelegoLabs/Delego-backend.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node init && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: add eslint'",
    "test": "vitest run",
    "ts-benchmark:encryption": "node --experimental-specifier-resolution=node dist/encryption/benchmark.js",
    "ts-benchmark:log-chunks": "node --experimental-specifier-resolution=node dist/logChunkCompressionBenchmark.js"
  },
  "dependencies": {
    "@delegolabs/types": "workspace:*",
    "@stellar/stellar-sdk": "^16.0.0",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.0.0",
    "ioredis": "^5.11.1",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
