{
  "name": "@delegolabs/cdc",
  "version": "0.0.1",
  "private": true,
  "description": "Delego Change Data Capture service using PostgreSQL logical replication (or Debezium) with exactly-once event publishing to the Redis bus",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "node init && tsc",
    "dev": "node init && tsx watch src/index.ts",
    "start": "node init && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: add eslint'",
    "test": "vitest run"
  },
  "dependencies": {
    "@delegolabs/types": "workspace:*",
    "@delegolabs/utils": "workspace:*",
    "ioredis": "^5.11.1",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
