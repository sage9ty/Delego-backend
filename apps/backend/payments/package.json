{
  "name": "@delegolabs/payments",
  "version": "0.0.1",
  "private": true,
  "description": "Delego payments service",
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./fee-estimator": {
      "types": "./dist/escrow/feeEstimator.d.ts",
      "import": "./dist/escrow/feeEstimator.js",
      "default": "./escrow/feeEstimator.ts"
    }
  },
  "scripts": {
    "build": "node init && tsc",
    "dev": "node init && tsx watch src/index.ts",
    "start": "node init && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'TODO: add eslint'",
    "test": "vitest run"
  },
  "dependencies": {
    "@delegolabs/types": "workspace:*",
    "@delegolabs/utils": "workspace:*",
    "@aws-sdk/client-kms": "^3.750.0",
    "pg": "^8.21.0",
    "ioredis": "^5.11.1",
    "bullmq": "^5.78.1",
    "uuid": "^9.0.1",
    "@stellar/stellar-sdk": "^16.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "vitest": "^2.0.0"
  }
}
