{
  "name": "delego-backend",
  "version": "0.0.1",
  "private": true,
  "description": "Backend microservices, agents, and shared SDK for the Delego AI commerce platform",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "node init && pnpm -r build",
    "dev": "node init && pnpm --parallel -r --filter './apps/backend/*' --filter './agents' dev",
    "dev:gateway": "node init && pnpm --filter @delegolabs/gateway dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm --filter @delegolabs/tests-unit test",
    "test:integration": "pnpm --filter @delegolabs/tests-integration test",
    "test:e2e": "pnpm --filter @delegolabs/tests-e2e test",
    "db:migrate": "node scripts/setup/migrate.js",
    "db:migrate:status": "node scripts/setup/migrate.js --status",
    "db:migrate:dry-run": "node scripts/setup/migrate.js --dry-run",
    "db:migrate:create": "node scripts/setup/migrate.js --create",
    "db:seed": "node scripts/setup/seed.js",
    "db:ts-maintain:once": "node scripts/time-series/maintain.js --once",
    "db:ts-maintain": "node scripts/time-series/maintain.js --interval 60",
    "db:ts-benchmark": "node scripts/time-series/benchmark.js",
    "db:encryption-benchmark": "pnpm --filter @delegolabs/utils ts-benchmark:encryption",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "clean": "pnpm -r exec rm -rf dist .next node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@types/node": "^25.9.3",
    "husky": "^9.1.7",
    "pg": "^8.21.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.20.0",
      "fast-uri": "^3.1.7",
      "follow-redirects": "^1.16.1"
    }
  }
}
